# Mẫu biến môi trường cho Vite. Copy thành .env (hoặc .env.local) khi cần; không commit giá trị thật.
# Endpoint API/socket KHÔNG đọc từ đây: app đọc từ config.json trong thư mục userData
# (Windows: %APPDATA%\ncc-system\config.json), chỉnh trong phần cài đặt của app.

# Bán vé bằng voucher giấy tại POS (P5), mặc định tắt. Cũng có thể đặt trực tiếp khi chạy/build:
#   VITE_PAPER_VOUCHER_SALE_ENABLED=true npm run dev
VITE_PAPER_VOUCHER_SALE_ENABLED=false
